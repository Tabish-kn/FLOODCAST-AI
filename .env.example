# ==============================================================================
# FloodCast AI Configuration Environment
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
APP_NAME="FloodCast AI"
APP_VERSION="1.0.0"

# Server Settings
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
# For local dev without PostgreSQL: sqlite:///./floodcast.db
# For production PostgreSQL: postgresql+psycopg2://floodcast:secret_password@localhost:5432/floodcast_db
DATABASE_URL=sqlite:///./floodcast.db

# Security & Tokens
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Study Area Coordinates (Default: Mumbai MMR Bounding Box)
STUDY_AREA_NAME=Mumbai
STUDY_AREA_MIN_LON=72.75
STUDY_AREA_MAX_LON=73.05
STUDY_AREA_MIN_LAT=18.85
STUDY_AREA_MAX_LAT=19.30

# External APIs & Mode
DEMO_MODE=True
OPEN_METEO_API_ENABLED=True
COPENICUS_DATA_SPACE_ENABLED=False

# Storage Paths
DATA_DIR=./data
MODEL_ARTIFACTS_DIR=./data/models
UPLOAD_DIR=./data/uploads
